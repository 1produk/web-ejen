rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email != null && request.auth.token.email.lower() == 'infaq.my@gmail.com') ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Users Collection
    match /users/{userId} {
      allow get: if true;
      allow list: if isSignedIn();
      // Allow user creation or bootstrap admin
      allow create: if isSignedIn() && (
        isAdmin() ||
        (isOwner(userId) && request.resource.data.accountStatus == 'Pending' && request.resource.data.role == 'buyer')
      );
      // Regular user cannot escalate role or set accountStatus to 'Aktif'
      allow update: if isSignedIn() && (
        isAdmin() ||
        (isOwner(userId) &&
         request.resource.data.role == resource.data.role &&
         (request.resource.data.accountStatus == resource.data.accountStatus || request.resource.data.accountStatus == 'Pending'))
      );
      allow delete: if isAdmin();
    }

    // Landing Pages Collection
    match /landingPages/{pageId} {
      allow get: if true;
      allow list: if true;
      allow create, update: if isSignedIn() && (
        isAdmin() ||
        (isOwner(pageId) || (request.resource.data.userId == request.auth.uid))
      );
      allow delete: if isAdmin() || (isSignedIn() && isOwner(pageId));
    }

    // Products Collection
    match /products/{productId} {
      allow get, list: if true;
      allow create, update, delete: if isSignedIn() && (
        isAdmin() ||
        (request.resource.data.userId == request.auth.uid || resource.data.userId == request.auth.uid)
      );
    }

    // Orders Collection
    match /orders/{orderId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn() && (
        isAdmin() ||
        (request.resource.data.userId == request.auth.uid && request.resource.data.orderStatus == 'Menunggu Pengesahan')
      );
      allow update: if isSignedIn() && (
        isAdmin() ||
        (resource.data.userId == request.auth.uid && request.resource.data.orderStatus == 'Menunggu Pengesahan')
      );
      allow delete: if isAdmin();
    }

    // Subscriptions Collection
    match /subscriptions/{subId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && (
        isAdmin() ||
        (request.resource.data.userId == request.auth.uid && request.resource.data.status == 'Menunggu Bayaran')
      );
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Notifications Collection
    match /notifications/{notifId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // Admin Audit Logs Collection: Only readable by admin
    match /adminAuditLogs/{logId} {
      allow get, list: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // Slugs Collection
    match /slugs/{slug} {
      allow get, list: if true;
      allow create, update, delete: if isSignedIn();
    }
  }
}
